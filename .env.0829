# MomentSeek 0829 Development Environment - Ascend
ENV_PROFILE=prod.ascend
RELEASE_MANIFEST_PATH=/app/release.json

# Development Mode (启用后代码修改自动重载，无需重构镜像)
DEV_MODE=true
DEV_SKIP_BUILD=false  # true=完全跳过构建，false=仅在镜像不存在时构建

# Port Configuration (避免与8000冲突)
APP_PORT=8100
APP_PUBLIC_URL=http://127.0.0.1:8100

# Container Paths (固定)
APP_DATA_DIR=/app/runtime
APP_MODEL_DIR=/app/models

# Host Paths (0829专用目录)
HOST_RUNTIME_DIR=/home/momentseek_0829_develop/workplace/MomentSeek/runtime
HOST_MODEL_DIR=/home/momentseek-29154/models/platform

# NPU Configuration (需要确认可用的NPU设备号)
NPU_ENABLED=true
NPU_DEVICE_ID=0
HOST_NPU_DEVICE_ID=4
ASCEND_VISIBLE_DEVICES=4
ASCEND_RT_VISIBLE_DEVICES=4

# Other Hardware
CUDA_ENABLED=false

# Indexing Configuration
INDEXER_MODE=daemon
NPU_WORKER_MODE=isolated
INDEXER_IDLE_TIMEOUT_SECONDS=0

# Thread Control
TORCH_DEVICE_BACKEND_AUTOLOAD=0
OPENBLAS_NUM_THREADS=8
OPENBLAS_DEFAULT_NUM_THREADS=8
OMP_NUM_THREADS=8
MKL_NUM_THREADS=8
NUMEXPR_NUM_THREADS=8
BLIS_NUM_THREADS=8
TOKENIZERS_PARALLELISM=false

# Visual Model
CLIP_MODEL=ViT-B-32
CLIP_PRETRAINED=/app/models/ViT-B-32.openai.bin
VISUAL_MODEL=siglip2-so400m-384
VISUAL_HF_CACHE_DIR=/app/models/hf-cache
VISUAL_SAMPLE_FPS=5.0
VISUAL_SEGMENT_SECONDS=5.0
VISUAL_BATCH_SIZE=32

# Face Model
FACE_MODEL=buffalo_l
FACE_SAMPLE_FPS=1.0
FACE_PROVIDER=cann
FACE_ORT_INTRA_OP_THREADS=8
FACE_ORT_INTER_OP_THREADS=1

# ASR Configuration
ASR_ENGINE=funasr
ASR_MODEL=turbo
ASR_ZH_MODEL=iic/SenseVoiceSmall
ASR_DEVICE=auto
ASR_LANGUAGE=zh
ASR_VAD_STRATEGY=silero_12s
ASR_MODEL_LOCAL_FILES_ONLY=true
ASR_SEMANTIC_ENABLED=true
ASR_SEMANTIC_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
ASR_SEMANTIC_DEVICE=cpu
ASR_SEMANTIC_LOCAL_FILES_ONLY=true

# Speaker Recognition
SPEAKER_DEVICE=npu
SPEAKER_MODEL_REPO=/app/models/3D-Speaker
SPEAKER_MODEL_CACHE_DIR=/app/models/3dspeaker-cache

# OCR Configuration
OCR_ENGINE=rapidocr_acl
OCR_DEVICE=npu
OCR_ACL_MODEL_DIR=rapidocr/ascend/910b4-cann9-profile
OCR_VERSION=PP-OCRv6
OCR_DET_LANG=ch
OCR_REC_LANG=ch
OCR_MODEL_TYPE=small
OCR_SAMPLE_FPS=0.5
OCR_SEMANTIC_ENABLED=true

# Model Manifest
MODEL_MANIFEST=deploy/models/ascend-prod.models.json

# Milvus Configuration (使用独立的Milvus实例)
MILVUS_ENABLED=true
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19531
MILVUS_READ_ENABLED=true
MILVUS_WRITE_ENABLED=true
MILVUS_FALLBACK_ENABLED=true
MILVUS_QUERY_TIMEOUT_SECONDS=3
MILVUS_SEARCH_VIDEO_BATCH_SIZE=8

# Visual模态优化配置
VISUAL_USE_ANN_SEARCH=true
VISUAL_USE_DISKANN=true
VISUAL_ANN_TOP_K=500
VISUAL_SAMPLE_SIZE=500
VISUAL_SAMPLE_STRATEGY=stratified

# Search Prewarm (禁用required避免启动时NPU资源冲突)
SEARCH_PREWARM_ENABLED=false
SEARCH_PREWARM_REQUIRED=false

# Query Orchestration (可选)
ORCHESTRATION_ENABLED=false
ORCHESTRATION_CONFIG_PATH=deploy/orchestration/qwen35-vllm.json
ORCHESTRATION_PROFILE=qwen35-unified
ORCHESTRATION_FAIL_OPEN=true
ORCHESTRATION_TRACE_ENABLED=true
ORCHESTRATION_TRACE_PATH=/app/runtime/orchestration-traces.jsonl

# Milvus Compose Configuration
COMPOSE_PROJECT_NAME=momentseek-0829
MOMENTSEEK_NETWORK_NAME=momentseek-0829-net
MILVUS_GRPC_PORT=19531
MILVUS_HEALTH_PORT=9092
MINIO_CONSOLE_PORT=9002
MILVUS_CPUS=4
MILVUS_MEMORY_LIMIT=4g

# Base Image
ASCEND_RUNTIME_IMAGE=swr.cn-south-1.myhuaweicloud.com/ascendhub/mindie:3.0.0b2-800I-A2-py311-openeuler24.03-lts
