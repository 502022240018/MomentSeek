# OCR Hybrid Search Configuration (DiskANN + BM25)
# These settings control the OCR v2 hybrid search behavior

# Recall size for both Dense (DiskANN) and Sparse (BM25) searches
# Each retrieval method recalls this many candidates before fusion
# Recommended: 50-200 (higher = better recall but slower)
OCR_HYBRID_RECALL_SIZE=100

# Lexical (BM25) weight in the hybrid fusion
# Semantic weight is automatically calculated as 1.0 - lexical_weight
# Recommended: 0.6-0.8 (OCR benefits from lexical-first strategy)
OCR_LEXICAL_WEIGHT=0.7

# DiskANN search_list parameter
# Controls the search scope within the DiskANN index
# Recommended: 100-200 (higher = more accurate but slower)
OCR_DISKANN_SEARCH_LIST=100
